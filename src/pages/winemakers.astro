---
import { getWinemakers } from '../lib/sanity.js';

const winemakers = await getWinemakers();

const regionNames = {
  'goriska-brda': { en: 'Goriška Brda', sl: 'Goriška Brda', de: 'Goriška Brda', it: 'Goriška Brda', ru: 'Горишка Брда', zh: '戈里什卡布尔达' },
  'vipavska-dolina': { en: 'Vipavska dolina', sl: 'Vipavska dolina', de: 'Vipava-Tal', it: 'Valle del Vipacco', ru: 'Долина Випава', zh: '维帕瓦河谷' },
  'kras': { en: 'Kras', sl: 'Kras', de: 'Karst', it: 'Carso', ru: 'Карст', zh: '喀斯特' },
  'slovenska-istra': { en: 'Slovenska Istra', sl: 'Slovenska Istra', de: 'Slowenisches Istrien', it: 'Istria Slovena', ru: 'Словенская Истрия', zh: '斯洛文尼亚伊斯特拉' },
  'stajerska': { en: 'Štajerska Slovenija', sl: 'Štajerska Slovenija', de: 'Štajerska Slovenija', it: 'Štajerska Slovenija', ru: 'Штаерская Словения', zh: '斯塔耶尔斯卡' },
  'prekmurje': { en: 'Prekmurje', sl: 'Prekmurje', de: 'Prekmurje', it: 'Prekmurje', ru: 'Прекмурье', zh: '普雷克穆列' },
  'dolenjska': { en: 'Dolenjska', sl: 'Dolenjska', de: 'Dolenjska', it: 'Dolenjska', ru: 'Доленьская', zh: '多连斯卡' },
  'bizeljsko-sremic': { en: 'Bizeljsko-Sremič', sl: 'Bizeljsko-Sremič', de: 'Bizeljsko-Sremič', it: 'Bizeljsko-Sremič', ru: 'Бизельско-Шремич', zh: '比泽利斯科-斯雷米奇' },
  'bela-krajina': { en: 'Bela krajina', sl: 'Bela krajina', de: 'Bela krajina', it: 'Bela krajina', ru: 'Бела Краина', zh: '贝拉克拉伊纳' },
};
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Winemakers — Vino Bled</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Jost:wght@300;400;500&family=Noto+Serif+SC:wght@300;400&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#1a1410;--bg2:#221c15;--bg3:#2a221a;
  --cream:#f0e8d8;--cream-dim:#bfb5a0;
  --terra:#c4613a;--ochre:#c49a3a;--olive:#6b7a42;
  --border:rgba(232,224,208,0.12);--border2:rgba(232,224,208,0.25);
  --serif:"Cormorant Garamond",Georgia,serif;--sans:"Jost",sans-serif;
}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--cream);font-family:var(--sans);font-weight:300;font-size:16px;line-height:1.7;overflow-x:hidden}
.lang-bar{position:fixed;top:0;left:0;right:0;z-index:200;display:flex;justify-content:flex-end;align-items:center;padding:.4rem 3rem;background:rgba(26,20,16,.97);border-bottom:1px solid var(--border);gap:.25rem}
.lang-btn{font-family:var(--sans);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:var(--cream-dim);background:transparent;border:none;padding:.3rem .6rem;cursor:pointer;border-radius:2px;transition:color .2s,background .2s}
.lang-btn:hover{color:var(--cream)}
.lang-btn.active{color:var(--terra);background:rgba(196,97,58,.1)}
.lang-sep{color:var(--border2);font-size:.7rem}
nav{position:sticky;top:30px;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:1.25rem 3rem;border-bottom:1px solid var(--border);background:rgba(26,20,16,.95);backdrop-filter:blur(12px)}
.nav-logo{font-family:var(--serif);font-size:1.1rem;color:var(--cream);text-decoration:none}
.nav-logo span{color:var(--terra)}
.nav-back{font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--cream-dim);text-decoration:none;transition:color .2s}
.nav-back:hover{color:var(--cream)}
.page-hero{padding:4rem 3rem 3rem;border-bottom:1px solid var(--border);background:var(--bg2)}
.page-eyebrow{font-size:.65rem;letter-spacing:.22em;text-transform:uppercase;color:var(--terra);margin-bottom:1rem;display:flex;align-items:center;gap:.75rem}
.page-eyebrow::before{content:"";display:block;width:1.5rem;height:1px;background:var(--terra)}
.page-title{font-family:var(--serif);font-size:clamp(2.5rem,5vw,4rem);font-weight:300;line-height:1.1;color:var(--cream);margin-bottom:1rem}
.page-title em{font-style:italic;color:var(--cream-dim)}
.winemakers-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1px;background:var(--border);padding:3rem;gap:1.5rem}
.winemaker-card{background:var(--bg2);border:1px solid var(--border);border-radius:2px;overflow:hidden;transition:border-color .3s}
.winemaker-card:hover{border-color:var(--border2)}
.winemaker-photo{width:100%;height:260px;object-fit:cover;display:block}
.winemaker-photo-placeholder{width:100%;height:260px;background:var(--bg3);display:flex;align-items:center;justify-content:center;color:var(--cream-dim);font-size:.75rem;letter-spacing:.1em;text-transform:uppercase}
.winemaker-body{padding:1.5rem}
.winemaker-region{font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:var(--terra);margin-bottom:.5rem}
.winemaker-name{font-family:var(--serif);font-size:1.5rem;font-weight:400;color:var(--cream);margin-bottom:1rem;line-height:1.2}
.winemaker-desc{font-size:.88rem;color:var(--cream-dim);line-height:1.75;margin-bottom:1.25rem}
.winemaker-link{font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;color:var(--terra);text-decoration:none}
.winemaker-link:hover{color:var(--ochre)}
.cta-block{padding:2rem 3rem;text-align:center;border-top:1px solid var(--border);background:var(--bg2)}
.cta-title{font-family:var(--serif);font-size:clamp(1.5rem,3vw,2rem);font-weight:300;color:var(--cream);margin-bottom:.75rem}
.cta-sub{font-size:.95rem;color:var(--cream-dim);margin-bottom:1.5rem}
.btn-primary{font-family:var(--sans);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--bg);background:var(--terra);padding:.85rem 2.5rem;border-radius:2px;text-decoration:none;transition:background .2s;display:inline-block}
.btn-primary:hover{background:var(--ochre)}
footer{padding:2rem 3rem;border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem}
.footer-logo{font-family:var(--serif);color:var(--cream-dim)}
.footer-logo span{color:var(--terra)}
.footer-copy{font-size:.72rem;color:rgba(168,158,138,.4)}
@media(max-width:768px){
  nav,.page-hero,.winemakers-grid,.cta-block,footer{padding-left:1.5rem;padding-right:1.5rem}
  .lang-bar{padding:.4rem 1rem;flex-wrap:wrap;justify-content:center}
  .winemakers-grid{grid-template-columns:1fr}
}
</style>
</head>
<body>

<div class="lang-bar">
  <button class="lang-btn active" data-lang="en" onclick="setLang('en')">EN</button><span class="lang-sep">·</span>
  <button class="lang-btn" data-lang="sl" onclick="setLang('sl')">SL</button><span class="lang-sep">·</span>
  <button class="lang-btn" data-lang="de" onclick="setLang('de')">DE</button><span class="lang-sep">·</span>
  <button class="lang-btn" data-lang="it" onclick="setLang('it')">IT</button><span class="lang-sep">·</span>
  <button class="lang-btn" data-lang="ru" onclick="setLang('ru')">RU</button><span class="lang-sep">·</span>
  <button class="lang-btn" data-lang="zh" onclick="setLang('zh')">中文</button>
</div>

<nav>
  <a href="/index.html" class="nav-logo">Vino <span>Bled</span></a>
  <a href="/index.html#explore" class="nav-back" data-i18n="nav_back">← Back to wines</a>
</nav>

<div class="page-hero">
  <div class="page-eyebrow" data-i18n="eyebrow">Our winemakers</div>
  <h1 class="page-title" data-i18n="page_title">The people behind <em>every bottle.</em></h1>
</div>

<div class="winemakers-grid">
  {winemakers.map((wm) => (
    <div class="winemaker-card">
      {wm.photo 
        ? <img class="winemaker-photo" src={wm.photo} alt={wm.name} loading="lazy" />
        : <div class="winemaker-photo-placeholder">Photo</div>
      }
      <div class="winemaker-body">
        <div class="winemaker-region" data-region={wm.region}>{wm.region}</div>
        <div class="winemaker-name">{wm.name}</div>
        {wm.description && (
          <div class="winemaker-desc" 
               data-desc-en={wm.description.en || ''}
               data-desc-sl={wm.description.sl || ''}
               data-desc-de={wm.description.de || ''}
               data-desc-it={wm.description.it || ''}
               data-desc-ru={wm.description.ru || ''}
               data-desc-zh={wm.description.zh || ''}>
            {wm.description.en || wm.description.sl || ''}
          </div>
        )}
        {wm.website && (
          <a href={wm.website} target="_blank" rel="noopener" class="winemaker-link" data-i18n="visit_website">
            Visit website →
          </a>
        )}
      </div>
    </div>
  ))}
</div>

<div class="cta-block">
  <div class="cta-title" data-i18n="cta_title">Ready to taste?</div>
  <p class="cta-sub" data-i18n="cta_sub">Book a tasting in our historic cellar in Bled.</p>
  <a href="/index.html#booking" class="btn-primary" data-i18n="cta_btn">Book a tasting</a>
</div>

<footer>
  <div class="footer-logo">Vino <span>Bled</span> — Slovenia Wine Experience</div>
  <div class="footer-copy">© 2025 Vino Bled. Bled, Slovenia.</div>
</footer>

<script define:vars={{ regionNames }}>
const T = {
  en: { nav_back:"← Back to wines", eyebrow:"Our winemakers", page_title:"The people behind <em>every bottle.</em>", visit_website:"Visit website →", cta_title:"Ready to taste?", cta_sub:"Book a tasting in our historic cellar in Bled.", cta_btn:"Book a tasting" },
  sl: { nav_back:"← Nazaj na vina", eyebrow:"Naši vinarji", page_title:"Ljudje za <em>vsako steklenico.</em>", visit_website:"Obišči spletno stran →", cta_title:"Pripravljeni na degustacijo?", cta_sub:"Rezervirajte degustacijo v zgodovinski kleti v Bledu.", cta_btn:"Rezervirajte degustacijo" },
  de: { nav_back:"← Zurück zu Weine", eyebrow:"Unsere Winzer", page_title:"Die Menschen hinter <em>jeder Flasche.</em>", visit_website:"Website besuchen →", cta_title:"Bereit zum Verkosten?", cta_sub:"Buchen Sie eine Verkostung in unserem historischen Keller in Bled.", cta_btn:"Verkostung buchen" },
  it: { nav_back:"← Torna ai vini", eyebrow:"I nostri produttori", page_title:"Le persone dietro <em>ogni bottiglia.</em>", visit_website:"Visita il sito →", cta_title:"Pronti ad assaggiare?", cta_sub:"Prenota una degustazione nella nostra cantina storica a Bled.", cta_btn:"Prenota una degustazione" },
  ru: { nav_back:"← Назад к винам", eyebrow:"Наши виноделы", page_title:"Люди за <em>каждой бутылкой.</em>", visit_website:"Посетить сайт →", cta_title:"Готовы к дегустации?", cta_sub:"Забронируйте дегустацию в нашем историческом погребе в Бледе.", cta_btn:"Забронировать дегустацию" },
  zh: { nav_back:"← 返回葡萄酒", eyebrow:"我们的酿酒师", page_title:"每一瓶酒背后的<em>人。</em>", visit_website:"访问网站 →", cta_title:"准备好品酒了吗？", cta_sub:"在布莱德历史酒窖预订一次品酒体验。", cta_btn:"预订品酒" },
};

function setLang(l) {
  const t = T[l] || T.en;
  document.documentElement.lang = l;
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const k = el.getAttribute('data-i18n');
    if(t[k] !== undefined) el.innerHTML = t[k];
  });
  // Update descriptions
  document.querySelectorAll('.winemaker-desc').forEach(el => {
    const desc = el.getAttribute('data-desc-' + l) || el.getAttribute('data-desc-en') || '';
    if(desc) el.textContent = desc;
  });
  // Update region names
  document.querySelectorAll('[data-region]').forEach(el => {
    const r = el.getAttribute('data-region');
    if(regionNames[r] && regionNames[r][l]) el.textContent = regionNames[r][l];
  });
  // Update buttons
  document.querySelectorAll('.lang-btn').forEach(btn => {
    btn.classList.toggle('active', btn.getAttribute('data-lang') === l);
  });
  localStorage.setItem('vb_lang', l);
  document.body.style.fontFamily = l === 'zh' ? "'Noto Serif SC',sans-serif" : '';
}

document.addEventListener('DOMContentLoaded', function() {
  const saved = localStorage.getItem('vb_lang') || 'en';
  setLang(saved);
});
</script>
</body>
</html>
