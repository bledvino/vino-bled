  de: {
    nav_back: "← Zurück zu Weine",
    eyebrow: "Weinregionen Sloweniens",
    page_title: "Neun Bezirke,<br><em>ein Land.</em>",
    page_intro: "Von den sonnenverwöhnten Hügeln der Goriška Brda bis zu den kühlen Terrassenweingärten der Štajerska — Slowenien vereint auf der Fläche einer kleinen italienischen Provinz eine außergewöhnliche Vielfalt an Terroirs. Drei Makroregionen, neun Bezirke — jeder geprägt durch Boden, Wind und Winzertradition.",
    r01: 'Primorska', r01_sub: "Mediterran · 4 Bezirke · ~6.400 ha",
