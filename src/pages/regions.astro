<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Wine Regions — Vino Bled</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#1a1410;--bg2:#221c15;--bg3:#2a221a;
  --cream:#f0e8d8;--cream-dim:#bfb5a0;
  --terra:#c4613a;--ochre:#c49a3a;--olive:#6b7a42;
  --border:rgba(232,224,208,0.12);--border2:rgba(232,224,208,0.25);
  --serif:'Cormorant Garamond',Georgia,serif;--sans:'Jost',sans-serif;
}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--cream);font-family:var(--sans);font-weight:300;font-size:16px;line-height:1.7;overflow-x:hidden}

/* LANG BAR */
.lang-bar{display:flex;justify-content:flex-end;align-items:center;padding:.4rem 3rem;background:rgba(26,20,16,.97);border-bottom:1px solid var(--border);gap:.25rem}
.lang-btn{font-family:var(--sans);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:var(--cream-dim);background:transparent;border:none;padding:.3rem .6rem;cursor:pointer;border-radius:2px;transition:color .2s,background .2s}
.lang-btn:hover{color:var(--cream)}
.lang-btn.active{color:var(--terra);background:rgba(196,97,58,.1)}
.lang-sep{color:var(--border2);font-size:.7rem}

/* NAV */
nav{display:flex;align-items:center;justify-content:space-between;padding:1.5rem 3rem;border-bottom:1px solid var(--border);position:sticky;top:30px;background:rgba(26,20,16,.95);backdrop-filter:blur(12px);z-index:100}
.nav-logo{font-family:var(--serif);font-size:1.1rem;color:var(--cream);text-decoration:none}
.nav-logo span{color:var(--terra)}
.nav-back{font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--cream-dim);text-decoration:none;display:flex;align-items:center;gap:.5rem;transition:color .2s}
.nav-back:hover{color:var(--cream)}
.nav-back::before{content:'←'}

/* HERO */
.page-hero{padding:2.5rem 3rem 2rem;border-bottom:1px solid var(--border);background:var(--bg2)}
.page-eyebrow{font-size:.65rem;letter-spacing:.22em;text-transform:uppercase;color:var(--terra);margin-bottom:.5rem;display:flex;align-items:center;gap:.75rem}
.page-eyebrow::before{content:'';display:block;width:1.5rem;height:1px;background:var(--terra)}
.page-title{font-family:var(--serif);font-size:clamp(2.5rem,5vw,4.5rem);font-weight:300;line-height:1.1;color:var(--cream);margin-bottom:.75rem}
.page-title em{font-style:italic;color:var(--cream-dim)}
.page-intro{font-size:1.05rem;color:var(--cream-dim);max-width:680px;line-height:1.85}

/* MAP */
.map-section{padding:1.5rem;border-bottom:1px solid var(--border)}
.map-section img{width:100%;max-width:900px;display:block;margin:0 auto;border-radius:2px;border:1px solid var(--border)}

/* REGION BLOCKS */
.region-block{border-bottom:1px solid var(--border)}
.region-header{padding:1.5rem 3rem 2rem;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:2rem;transition:background .3s}
.region-header:hover{background:var(--bg2)}
.region-header-left{display:flex;align-items:baseline;gap:1.5rem}
.region-num{font-family:var(--serif);font-size:3rem;font-weight:300;color:var(--border2);line-height:1;transition:color .3s}
.region-block.open .region-num{color:var(--terra)}
.region-name{font-family:var(--serif);font-size:2rem;font-weight:300;color:var(--cream)}
.region-tag{font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;color:var(--cream-dim);border:1px solid var(--border);padding:.25rem .75rem;border-radius:1px}
.region-toggle{font-size:1.2rem;color:var(--terra);transition:transform .3s;flex-shrink:0}
.region-block.open .region-toggle{transform:rotate(45deg)}
.region-body{display:none;padding:0 3rem 1.5rem}
.region-block.open .region-body{display:block}

/* DISTRICT */
.district{padding:1.25rem 0;border-top:1px solid var(--border)}
.district:first-child{border-top:none;padding-top:0}
.district-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;align-items:start}
.district-name{font-family:var(--serif);font-size:1.6rem;font-weight:400;color:var(--cream);margin-bottom:.5rem}
.district-label{font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:var(--terra);margin-bottom:.5rem}
.district-desc{font-size:.95rem;color:var(--cream-dim);line-height:1.85;margin-bottom:.75rem}
.grapes-title{font-size:.62rem;letter-spacing:.15em;text-transform:uppercase;color:var(--ochre);margin-bottom:.6rem}
.grape-tags{display:flex;flex-wrap:wrap;gap:.4rem}
.grape-tag{font-size:.72rem;padding:.25rem .75rem;border:1px solid rgba(196,154,58,.3);border-radius:1px;color:var(--ochre)}
.winemakers-placeholder{background:var(--bg3);border:1px solid var(--border);border-radius:2px;padding:1.5rem;border-style:dashed}
.winemakers-title{font-size:.62rem;letter-spacing:.15em;text-transform:uppercase;color:var(--cream-dim);margin-bottom:.75rem}
.winemaker-slot{padding:.6rem 0;border-bottom:1px solid var(--border);font-size:.85rem;color:rgba(168,158,138,.5);font-style:italic}
.winemaker-slot:last-child{border-bottom:none}

/* FOOTER */
footer{padding:2rem 3rem;border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem}
.footer-logo{font-family:var(--serif);color:var(--cream-dim)}
.footer-logo span{color:var(--terra)}
.footer-copy{font-size:.72rem;color:rgba(168,158,138,.4)}

@media(max-width:800px){
  nav,section,.page-hero,.map-section,.region-header,.region-body{padding-left:1.5rem;padding-right:1.5rem}
  .district-grid{grid-template-columns:1fr}
  .region-header-left{flex-wrap:wrap}
}
</style>
</head>
<body>

<div class="lang-bar">
  <button class="lang-btn active" data-lang="en" onclick="applyLang('en')">EN</button><span class="lang-sep">·</span>
  <button class="lang-btn" data-lang="sl" onclick="applyLang('sl')">SL</button><span class="lang-sep">·</span>
  <button class="lang-btn" data-lang="de" onclick="applyLang('de')">DE</button><span class="lang-sep">·</span>
  <button class="lang-btn" data-lang="it" onclick="applyLang('it')">IT</button><span class="lang-sep">·</span>
  <button class="lang-btn" data-lang="ru" onclick="applyLang('ru')">RU</button><span class="lang-sep">·</span>
  <button class="lang-btn" data-lang="zh" onclick="applyLang('zh')">中文</button>
</div>
<nav>
  <a href="/index.html" class="nav-logo">Vino <span>Bled</span></a>
  <a href="/index.html#explore" class="nav-back" data-i18n="nav_back">Back to wines</a>
</nav>

<div class="page-hero">
  <div class="page-eyebrow" data-i18n="eyebrow">Wine regions of Slovenia</div>
  <h1 class="page-title" data-i18n="page_title">Nine districts,<br><em>one country.</em></h1>
  <p class="page-intro" data-i18n="page_intro">From the sun-baked hills of Goriška Brda to the cool terraced vineyards of Štajerska, Slovenia packs an extraordinary range of terroirs into a country the size of a small Italian province. Three macro-regions, nine distinct districts — each shaped by its own soil, wind and winemaking tradition. Here they are, one by one.</p>
</div>

<div class="map-section">
  <img src="/images/map-slovenia.jpg" alt="Wine regions of Slovenia">
</div>

<!-- PRIMORSKA -->
<div class="region-block open" id="primorska">
  <div class="region-header" onclick="toggleRegion('primorska')">
    <div class="region-header-left">
      <span class="region-num">01</span>
      <div>
        <div class="region-name" data-i18n="r01">Primorska</div>
        <div style="font-size:.85rem;color:var(--cream-dim);margin-top:.25rem" data-i18n="r01_sub">Mediterranean · 4 districts · ~6,400 ha</div>
      </div>
    </div>
    <span class="region-toggle">+</span>
  </div>
  <div class="region-body">

    <!-- Goriška Brda -->
    <div class="district">
      <div class="district-grid">
        <div>
                    <h2 class="district-name">Goriška Brda</h2>
          <p class="district-desc" data-i18n="d_brda">They call it the Slovenian Tuscany — and once you see the terraced hills rolling towards the Italian border, you understand why. But Brda is its own thing entirely. The legendary <em>opoka</em> soil — ancient flysch compressed into alternating layers of marl and sandstone — gives wines here an electrifying minerality that no other place in the world can replicate. Between the Julian Alps to the north and the warm Adriatic breath from the south, Rebula ripens slowly on impossibly steep slopes, harvested by hand, and makes wines of crystalline precision and depth. One producer for every eight inhabitants: this is wine country in the most fundamental sense.</p>
          <div class="grapes-title" data-i18n="grapes">Signature grapes</div>
          <div class="grape-tags">
            <span class="grape-tag">Rebula (Ribolla Gialla)</span>
            <span class="grape-tag">Merlot</span>
            <span class="grape-tag">Chardonnay</span>
            <span class="grape-tag">Pinot Grigio</span>
            <span class="grape-tag">Sauvignonasse</span>
            <span class="grape-tag">Cabernet Sauvignon</span>
          </div>
        </div>
        <div>
          <div class="winemakers-placeholder">
            <div class="winemakers-title" data-i18n="wm_title_brda">Our winemakers from Goriška Brda</div>
            <div class="winemaker-slot">— to be added —</div>
            <div class="winemaker-slot">— to be added —</div>
            <div class="winemaker-slot">— to be added —</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Vipavska dolina -->
    <div class="district">
      <div class="district-grid">
        <div>
                    <h2 class="district-name">Vipavska dolina</h2>
          <p class="district-desc" data-i18n="d_vipava">The Vipava Valley is shaped by wind. The <em>Burja</em> — a fierce northeast gale that can tear through the valley at 120 km/h ten times a year — keeps disease away, concentrates flavours, and defines the character of every bottle made here. Vines grow low to the ground, roots drilling fifteen metres deep into flysch soils to find water and minerals. The result is wines of surprising purity: white blends of Zelen, Pinela, Malvasia and Rebula that carry the freshness of the Alps and the warmth of the Adriatic simultaneously. This is also where Slovenia's most exciting winemaking experiments happen — an irreverent, forward-thinking valley that has nothing to prove.</p>
          <div class="grapes-title">Signature grapes</div>
          <div class="grape-tags">
            <span class="grape-tag">Zelen</span>
            <span class="grape-tag">Pinela</span>
            <span class="grape-tag">Malvasia</span>
            <span class="grape-tag">Rebula</span>
            <span class="grape-tag">Merlot</span>
            <span class="grape-tag">Cabernet Franc</span>
          </div>
        </div>
        <div>
          <div class="winemakers-placeholder">
            <div class="winemakers-title" data-i18n="wm_title_vipava">Our winemakers from Vipavska dolina</div>
            <div class="winemaker-slot">— to be added —</div>
            <div class="winemaker-slot">— to be added —</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Kras -->
    <div class="district">
      <div class="district-grid">
        <div>
                    <h2 class="district-name">Kras</h2>
          <p class="district-desc" data-i18n="d_kras">The word <em>karst</em> — used worldwide to describe limestone landscapes — was coined here. On this rugged plateau above the Gulf of Trieste, white limestone bedrock is blanketed with a layer of iron-rich red soil the colour of dried blood: <em>terra rossa</em>. From it comes Teran, one of Slovenia's most ancient and protected wines — a deep ruby-almost-black red with bracingly high acidity, wild berry aromas and an iron-mineral grip that feels like drinking the land itself. Sold in Viennese pharmacies in the 16th century as a remedy for anaemia. Some things are better explained through taste than history.</p>
          <div class="grapes-title">Signature grapes</div>
          <div class="grape-tags">
            <span class="grape-tag">Refošk / Teran (PDO)</span>
            <span class="grape-tag">Vitovska Grganja</span>
            <span class="grape-tag">Malvasia</span>
          </div>
        </div>
        <div>
          <div class="winemakers-placeholder">
            <div class="winemakers-title" data-i18n="wm_title_kras">Our winemakers from Kras</div>
            <div class="winemaker-slot">— to be added —</div>
            <div class="winemaker-slot">— to be added —</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Slovenska Istra -->
    <div class="district">
      <div class="district-grid">
        <div>
                    <h2 class="district-name">Slovenska Istra</h2>
          <p class="district-desc" data-i18n="d_istra">Slovenia's warmest vineyards look out over the Adriatic. Three winds take turns shaping the growing season: the cold <em>Burja</em>, the warm <em>Jugo</em>, and the salt-scented <em>Maestral</em> off the sea. Here Refošk is king — a grape of vivid cherry colour, firm acidity and a character that shifts from rich and velvety on the coast to darker and wilder just a few kilometres inland. And then there is Malvasia — queen of the Istrian whites — arriving with acacia blossom, citrus and bitter almond, a wine that smells of Mediterranean summers and lingers long on the finish. Wine traditions here trace back to Roman times, when Livia, wife of Augustus, reportedly had roads built into Istria just to secure her supply.</p>
          <div class="grapes-title">Signature grapes</div>
          <div class="grape-tags">
            <span class="grape-tag">Refošk</span>
            <span class="grape-tag">Malvasia Istriana</span>
            <span class="grape-tag">Cabernet Franc</span>
            <span class="grape-tag">Merlot</span>
            <span class="grape-tag">Rumeni Muskat</span>
          </div>
        </div>
        <div>
          <div class="winemakers-placeholder">
            <div class="winemakers-title" data-i18n="wm_title_istra">Our winemakers from Slovenska Istra</div>
            <div class="winemaker-slot">— to be added —</div>
            <div class="winemaker-slot">— to be added —</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- PODRAVJE -->
<div class="region-block open" id="podravje">
  <div class="region-header" onclick="toggleRegion('podravje')">
    <div class="region-header-left">
      <span class="region-num">02</span>
      <div>
        <div class="region-name" data-i18n="r02">Podravje</div>
        <div style="font-size:.85rem;color:var(--cream-dim);margin-top:.25rem" data-i18n="r02_sub">Continental · 2 districts · ~5,850 ha</div>
      </div>
    </div>
    <span class="region-toggle">+</span>
  </div>
  <div class="region-body">

    <!-- Štajerska Slovenija -->
    <div class="district">
      <div class="district-grid">
        <div>
                    <h2 class="district-name">Štajerska Slovenija</h2>
          <p class="district-desc" data-i18n="d_staj">Slovenia's largest wine district — nearly 40% of all national production — sits where the cool Pohorje Hills meet the warm breath of the Pannonian Plain. Steep terraced vineyards at 350–600 metres produce whites of remarkable aromatic precision and natural freshness. Sauvignon Blanc here develops a lively, herbaceous character; Šipon (Furmint) achieves genuine complexity; Rhine Riesling and Muscat offer some of the most expressive examples in Central Europe. And here stands the <em>Stara trta</em> in Maribor — a single grapevine over 450 years old, certified by Guinness as the world's oldest. Still producing grapes. Still making wine.</p>
          <div class="grapes-title">Signature grapes</div>
          <div class="grape-tags">
            <span class="grape-tag">Šipon (Furmint)</span>
            <span class="grape-tag">Sauvignon Blanc</span>
            <span class="grape-tag">Rhine Riesling</span>
            <span class="grape-tag">Welschriesling</span>
            <span class="grape-tag">Traminer</span>
            <span class="grape-tag">Muscat</span>
            <span class="grape-tag">Pinot Gris</span>
          </div>
        </div>
        <div>
          <div class="winemakers-placeholder">
            <div class="winemakers-title" data-i18n="wm_title_staj">Our winemakers from Štajerska</div>
            <div class="winemaker-slot">— to be added —</div>
            <div class="winemaker-slot">— to be added —</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Prekmurje -->
    <div class="district">
      <div class="district-grid">
        <div>
                    <h2 class="district-name">Prekmurje</h2>
          <p class="district-desc" data-i18n="d_prek">Tucked into Slovenia's northeastern corner, pressed between the Mura River and the Hungarian border, Prekmurje is a land apart — flat, quiet, unhurried, with volcanic soils and a deeply continental climate of hot summers and cold winters. Hungarian winemaking traditions bleed across the border; so does a taste for Welschriesling, Chardonnay, and Blaufränkisch (Modra Frankinja) with genuine depth and structure. Small production, low profile, singular character. This is where you find wines that taste like a place nobody has thought to visit yet.</p>
          <div class="grapes-title">Signature grapes</div>
          <div class="grape-tags">
            <span class="grape-tag">Welschriesling</span>
            <span class="grape-tag">Chardonnay</span>
            <span class="grape-tag">Blaufränkisch</span>
            <span class="grape-tag">Pinot Blanc</span>
          </div>
        </div>
        <div>
          <div class="winemakers-placeholder">
            <div class="winemakers-title" data-i18n="wm_title_prek">Our winemakers from Prekmurje</div>
            <div class="winemaker-slot">— to be added —</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- POSAVJE -->
<div class="region-block open" id="posavje">
  <div class="region-header" onclick="toggleRegion('posavje')">
    <div class="region-header-left">
      <span class="region-num">03</span>
      <div>
        <div class="region-name" data-i18n="r03">Posavje</div>
        <div style="font-size:.85rem;color:var(--cream-dim);margin-top:.25rem" data-i18n="r03_sub">Continental · 3 districts · ~2,650 ha</div>
      </div>
    </div>
    <span class="region-toggle">+</span>
  </div>
  <div class="region-body">

    <!-- Dolenjska -->
    <div class="district">
      <div class="district-grid">
        <div>
                    <h2 class="district-name">Dolenjska</h2>
          <p class="district-desc" data-i18n="d_dol">The birthplace of <em>Cviček</em> — Slovenia's most characterful traditional wine and one of the most unusual in all of Europe. A pale ruby blend of red and white grapes, light in body, high in acidity, low in alcohol, and totally honest about what it is: a wine made for food and company rather than for impressing anyone. The gently rolling hills of Dolenjska, cooled by alpine influences and warmed by continental summers, produce 7,500 winemakers who still make wine for the pleasure of it. Cviček has PGI protection — because you simply cannot make it anywhere else.</p>
          <div class="grapes-title">Signature grapes</div>
          <div class="grape-tags">
            <span class="grape-tag">Žametovka</span>
            <span class="grape-tag">Blaufränkisch</span>
            <span class="grape-tag">Welschriesling</span>
            <span class="grape-tag">Cviček blend (PGI)</span>
          </div>
        </div>
        <div>
          <div class="winemakers-placeholder">
            <div class="winemakers-title" data-i18n="wm_title_dol">Our winemakers from Dolenjska</div>
            <div class="winemaker-slot">— to be added —</div>
            <div class="winemaker-slot">— to be added —</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bizeljsko-Sremič -->
    <div class="district">
      <div class="district-grid">
        <div>
                    <h2 class="district-name">Bizeljsko-Sremič</h2>
          <p class="district-desc" data-i18n="d_biz">Between the Sava and Sotla rivers lies a landscape unlike anywhere else in Slovenia — vineyards protected from harsh northern winds by low mountains, and beneath the ground an extraordinary network of hand-dug caves called <em>repnice</em>, carved into soft sandstone to store wine at a perfect natural temperature. The Blaufränkisch from this district has come a long way from its humble origins: structured, spicy, and quietly impressive. The district is also building a reputation for sparkling wines made in the traditional method — cool nights and a long growing season doing what they do best.</p>
          <div class="grapes-title">Signature grapes</div>
          <div class="grape-tags">
            <span class="grape-tag">Blaufränkisch</span>
            <span class="grape-tag">Bizeljčan (traditional)</span>
            <span class="grape-tag">Pinot Noir</span>
            <span class="grape-tag">Chardonnay</span>
          </div>
        </div>
        <div>
          <div class="winemakers-placeholder">
            <div class="winemakers-title" data-i18n="wm_title_biz">Our winemakers from Bizeljsko-Sremič</div>
            <div class="winemaker-slot">— to be added —</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bela krajina -->
    <div class="district">
      <div class="district-grid">
        <div>
                    <h2 class="district-name">Bela krajina</h2>
          <p class="district-desc" data-i18n="d_bela">Slovenia's smallest wine district sits in the far south, where the Gorjanci Hills give way to warm limestone plains and the first hints of Adriatic warmth reach continental Posavje. The temperature swings between day and night are dramatic — which means one thing for wine: extraordinary aromatic intensity and freshness preserved in every bottle. Bela Krajina made the first ice wine and the first rosé in Slovenia. Its Blaufränkisch and Yellow Muscat are the district's signatures; its dessert wines are among the country's most celebrated. Small in size, large in ambition.</p>
          <div class="grapes-title">Signature grapes</div>
          <div class="grape-tags">
            <span class="grape-tag">Blaufränkisch</span>
            <span class="grape-tag">Gelber Muskateller</span>
            <span class="grape-tag">Sauvignon Blanc</span>
            <span class="grape-tag">Pinot Noir</span>
            <span class="grape-tag">Metliška Črnina (PGI)</span>
          </div>
        </div>
        <div>
          <div class="winemakers-placeholder">
            <div class="winemakers-title" data-i18n="wm_title_bela">Our winemakers from Bela krajina</div>
            <div class="winemaker-slot">— to be added —</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<div style="padding:1.5rem;text-align:center;border-bottom:1px solid var(--border);background:var(--bg2)">
  <div style="font-family:var(--serif);font-size:clamp(1.5rem,3vw,2.2rem);font-weight:300;color:var(--cream);margin-bottom:.75rem" data-i18n="cta_title">Ready to taste?</div>
  <p style="font-size:.95rem;color:var(--cream-dim);margin-bottom:1.75rem" data-i18n="cta_sub">Book a tasting in our historic cellar in the heart of Bled.</p>
