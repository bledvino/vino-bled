let lang='en';
function setLang(l){
  lang=l;
  localStorage.setItem('vb_lang',l);
  const t=T[l];
  document.documentElement.lang=l;
  document.querySelectorAll('[data-i18n]').forEach(el=>{
    const k=el.getAttribute('data-i18n');
    if(t[k]!==undefined) el.innerHTML=t[k];
  });
  document.querySelectorAll('[data-i18n-ph]').forEach(el=>{
    const k=el.getAttribute('data-i18n-ph');
    if(t[k]!==undefined) el.placeholder=t[k];
  });
  document.querySelectorAll('.lang-btn').forEach(btn=>{
    btn.classList.toggle('active',btn.onclick.toString().includes("'"+l+"'"));
  });
  document.body.style.fontFamily=l==='zh'?"'Noto Serif SC',sans-serif":'';
}

// Restore saved language
const savedLang=localStorage.getItem('vb_lang');
if(savedLang) setLang(savedLang);

const nav=document.getElementById('nav');
window.addEventListener('scroll',()=>nav.classList.toggle('scrolled',scrollY>60));

const obs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target);}});
},{threshold:0.1});
document.querySelectorAll('.fade-in').forEach(el=>obs.observe(el));

// Validation — mark touched on blur
document.querySelectorAll('.form-field input[required], .form-field select[required]').forEach(el => {
  el.addEventListener('blur', () => el.classList.add('touched'));
});

// Submit via fetch
document.getElementById('booking-form').addEventListener('submit', async function(e) {
  e.preventDefault();

  // Validate
  let valid = true;
  this.querySelectorAll('input[required], select[required]').forEach(el => {
    el.classList.add('touched');
    if (!el.value.trim()) valid = false;
  });
  if (!valid) return;

  const btn = this.querySelector('button[type="submit"]');
  btn.disabled = true;
  btn.textContent = '...';

  const data = {};
  new FormData(this).forEach((val, key) => data[key] = val);

  try {
    const res = await fetch('https://formspree.io/f/xrpzgdep', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(data)
    });

    if (res.ok) {
      this.style.display = 'none';
      document.getElementById('form-success').style.display = 'block';
    } else {
      btn.disabled = false;
      btn.textContent = document.querySelector('[data-i18n="f_submit"]')?.textContent || 'Request booking';
      alert('Something went wrong. Please try again.');
    }
  } catch(err) {
    btn.disabled = false;
    btn.textContent = document.querySelector('[data-i18n="f_submit"]')?.textContent || 'Request booking';
    alert('Connection error. Please try again.');
  }
});

</script>
